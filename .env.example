# Model used by the agent, as provider:model (any provider supported by LangChain's init_chat_model)
OPS_AGENT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPS_AGENT_MODEL=openai:gpt-4.1-mini
# OPENAI_API_KEY=

# Optional: model used by the LLM judge in the evals (defaults to OPS_AGENT_MODEL)
# OPS_AGENT_JUDGE_MODEL=

# Optional: Langfuse tracing (uv sync --extra tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
